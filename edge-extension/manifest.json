{
  "manifest_version": 3,
  "name": "MonLycée Auto-Connect",
  "version": "1.0.0",
  "description": "Connexion sécurisée en 1 clic à MonLycée.net sans jamais saisir de mot de passe.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.monlycee.net/*",
    "*://*.iledefrance.fr/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MonLycée Auto-Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
